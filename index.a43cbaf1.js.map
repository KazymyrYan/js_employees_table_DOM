// Перевірка даних форми
function checkData() {
    var form = document.querySelector(".new-employee-form");
    var inputName = form.querySelector('input[name="name"]');
    var inputPosition = form.querySelector('input[name="position"]');
    var inputOffice = form.querySelector('select[name="office"]');
    var inputAge = form.querySelector('input[name="age"]');
    var inputSalary = form.querySelector('input[name="salary"]');
    var message = "";
    var messageClass = "error";
    if (!inputName.value || !inputPosition.value || !inputOffice.value || !inputAge.value || !inputSalary.value) message = "Error! Please fill in all fields";
    else if (inputName.value.length < 4) message = "Error! Name must be at least 4 characters long";
    else if (inputAge.value < 18 || inputAge.value > 90) message = "Error! Age must be between 18 and 90";
    if (message) {
        createErrorMessage(message, messageClass);
        return false;
    }
    return true;
}
// Створення повідомлення
function createErrorMessage(message, messageClass) {
    var errorMessage = document.createElement("div");
    var messageTitle = document.createElement("p");
    errorMessage.classList.add("notification", messageClass);
    errorMessage.setAttribute("data-qa", "notification");
    messageTitle.classList.add("title");
    messageTitle.textContent = message;
    document.body.appendChild(errorMessage);
    errorMessage.appendChild(messageTitle);
    setTimeout(function() {
        errorMessage.remove();
    }, 4000);
}
// Додавання нового рядка
function addNewRow() {
    var form = document.querySelector(".new-employee-form");
    var inputName = form.querySelector('input[name="name"]');
    var inputPosition = form.querySelector('input[name="position"]');
    var inputOffice = form.querySelector('select[name="office"]');
    var inputAge = form.querySelector('input[name="age"]');
    var inputSalary = form.querySelector('input[name="salary"]');
    var newRow = document.createElement("tr");
    newRow.setAttribute("data-qa", "employee-row");
    var formattedSalary = "$".concat(Number(inputSalary.value).toLocaleString("en-US"));
    newRow.innerHTML = "\n    <td>".concat(inputName.value, "</td>\n    <td>").concat(inputPosition.value, "</td>\n    <td>").concat(inputOffice.value, "</td>\n    <td>").concat(inputAge.value, "</td>\n    <td>").concat(formattedSalary, "</td>\n    ");
    document.querySelector("tbody").appendChild(newRow);
    form.reset();
    createErrorMessage("Employee successfully added to the table!", "success");
    if (lastIndex !== null) sortRows(lastIndex);
}
// Додаємо обробники подій на клітинки таблиці
tbody.addEventListener("dblclick", function(e) {
    var cell = e.target.closest("td");
    if (!cell) return;
    enableCellEditing(cell);
});
// Функція для увімкнення редагування клітинок
function enableCellEditing(cell) {
    var originalValue = cell.textContent;
    var input = document.createElement("input");
    input.classList.add("cell-input");
    input.value = originalValue;
    cell.textContent = "";
    cell.appendChild(input);
    input.focus();
    // Додаємо обробник події для втрати фокусу
    input.addEventListener("blur", function() {
        if (input.value.trim() === "") cell.textContent = originalValue;
        else cell.textContent = input.value;
        input.remove();
    });
    // Додаємо обробник події для клавіші Enter
    input.addEventListener("keydown", function(e) {
        if (e.key === "Enter") {
            if (input.value.trim() === "") cell.textContent = originalValue;
            else cell.textContent = input.value;
            input.remove();
        }
    });
}

