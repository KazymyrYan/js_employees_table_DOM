"use strict";
var tHeads = document.querySelectorAll("thead th");
var tRows = document.querySelectorAll("tbody tr");
var lastIndex = null;
var sortAsc = true;
// Додаємо обробники подій на заголовки таблиці
tHeads.forEach(function(th) {
    th.addEventListener("click", function(e) {
        var index = Array.from(tHeads).indexOf(e.target);
        if (lastIndex === index) sortAsc = !sortAsc;
        else sortAsc = true;
        lastIndex = index;
        sortRows(index);
    });
});
// Функція для сортування рядків таблиці
function sortRows(index) {
    tRows = document.querySelectorAll("tbody tr");
    var sortedRows = Array.from(tRows).sort(function(a, b) {
        var aValue = a.children[index].textContent;
        var bValue = b.children[index].textContent;
        var aNum = parseFloat(aValue);
        var bNum = parseFloat(bValue);
        var compare;
        if (!isNaN(aNum) && !isNaN(bNum)) compare = aNum - bNum;
        else compare = aValue.localeCompare(bValue, undefined, {
            numeric: true
        });
        return sortAsc ? compare : -compare;
    });
    document.querySelector("tbody").innerHTML = "";
    sortedRows.forEach(function(row) {
        document.querySelector("tbody").appendChild(row);
    });
}
// Додаємо обробники подій на рядки таблиці
var tbody = document.querySelector("tbody");
tbody.addEventListener("click", function(e) {
